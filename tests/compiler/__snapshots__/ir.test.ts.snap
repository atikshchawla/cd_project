exports[`IR generation > matches the golden snapshot for every learning example > forLoop 1`] = `
[
  "define i32 @main() {",
  "entry:",
  "  %sum = alloca i32",
  "  %i = alloca i32",
  "  store 0, %sum",
  "  store 0, %i",
  "  br label %for.cond",
  "for.cond:",
  "  %0 = load %i",
  "  %cmp = icmp slt %0, 5",
  "  br %cmp, label %for.body, label %for.end",
  "for.body:",
  "  %1 = load %i",
  "  %cmp1 = icmp eq %1, 2",
  "  br %cmp1, label %if.then, label %if.end",
  "for.inc:",
  "  %4 = load %i",
  "  %inc = add %4, 1",
  "  store %inc, %i",
  "  br label %for.cond",
  "for.end:",
  "  %5 = load %sum",
  "  ret %5",
  "if.then:",
  "  br label %for.inc",
  "if.end:",
  "  %2 = load %sum",
  "  %3 = load %i",
  "  %add = add %2, %3",
  "  store %add, %sum",
  "  br label %for.inc",
  "}",
]
`;

